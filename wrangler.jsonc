{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "indexforge",
	"main": "worker/index.ts",
	"compatibility_date": "2024-04-03",
	"workers_dev": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// Worker must run for EVERY request: it attaches the security headers
		// (CSP, X-Frame-Options, ...) and the HTML no-cache policy to static
		// responses. With the previous ["/api/*"] form, asset-matching requests
		// (including the SPA entry index.html) were served directly by the
		// asset layer and never reached the Worker, silently dropping those
		// headers in production.
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "original-stock-index-db",
			// NOTE: database_id は GitHub Actions の Secret 機能で自動的に補完されます
			// ローカル開発時は wrangler.local.jsonc を使用してください
			"database_id": "__D1_DATABASE_ID__"
		}
	]
}