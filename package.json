{
  "name": "indexforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.test.json --noEmit && vite build",
    "preview": "vite preview",
    "predev:worker": "npm run build",
    "dev:worker": "wrangler dev --config wrangler.local.jsonc",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc",
    "deploy:local": "npm run build && wrangler deploy --config wrangler.local.jsonc",
    "db:migrate": "wrangler d1 execute original-stock-index-db --remote --config wrangler.local.jsonc --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute original-stock-index-db --local --config wrangler.local.jsonc --file=schema.sql",
    "db:migrate:columns": "node scripts/apply-migrations.mjs --remote",
    "db:migrate:columns:local": "node scripts/apply-migrations.mjs --local",
    "db:reset": "npm run db:reset:local",
    "db:reset:local": "wrangler d1 execute original-stock-index-db --local --config wrangler.local.jsonc --file=schema.dev.sql && wrangler d1 execute original-stock-index-db --local --config wrangler.local.jsonc --file=schema.sql && npm run db:seed:local",
    "db:reset:remote": "wrangler d1 execute original-stock-index-db --remote --config wrangler.local.jsonc --file=schema.dev.sql && wrangler d1 execute original-stock-index-db --remote --config wrangler.local.jsonc --file=schema.sql && npm run db:seed",
    "db:seed": "wrangler d1 execute original-stock-index-db --remote --config wrangler.local.jsonc --file=seed.sql",
    "db:seed:local": "wrangler d1 execute original-stock-index-db --local --config wrangler.local.jsonc --file=seed.sql",
    "db:schema:generate": "node scripts/generate-schema-steps.mjs",
    "typegen": "wrangler types",
    "check:first-paint": "node scripts/check-first-paint.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "framer-motion": "^12.10.5",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.5",
    "wrangler": "^4.151.3"
  }
}
